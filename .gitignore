# Non-mainstream platform artifacts fetched on demand by bin/php-impersonate-install.
# Committed: linux-x86_64 (glibc), macos-aarch64 (Apple Silicon), windows-x86_64.
/bin/linux-x86_64-musl/
/bin/linux-aarch64/
/bin/linux-aarch64-musl/
/bin/macos-x86_64/

# Fetched on demand by bin/php-impersonate-install; the executable engine
# serves Windows until it is present. Not committed while Windows FFI support
# is new: promote it with `composer update-binaries -- --libs-only --only=windows-x86_64`.
/bin/windows-x86_64/libcurl-impersonate.dll
