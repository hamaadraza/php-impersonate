parameters:
    level: 5
    paths:
        - src
    ignoreErrors:
        # PHP FFI is dynamic: methods declared in the C header via FFI::cdef()
        # and the CData `cdata` property cannot be seen by static analysis.
        -
            identifier: method.notFound
            path: src/Ffi/CurlImpersonate.php
        -
            identifier: property.notFound
            path: src/Ffi/CurlImpersonate.php
        # findHeaderValue() accepts external header arrays whose keys may be ints
        # at runtime despite the string-keyed phpdoc; the is_string() guard stays.
        -
            message: '#Call to function is_string\(\) with string will always evaluate to true#'
            path: src/Support/RequestPreparer.php
