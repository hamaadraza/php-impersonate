# Path-based git attributes
# https://www.kernel.org/pub/software/scm/git/docs/gitattributes.html

# Exclude tests, docs, and maintainer tooling from the composer dist package.
# NOTE: scripts/lib/Http.php and scripts/lib/BinaryInstaller.php MUST ship —
# bin/php-impersonate-install requires them at runtime on end-user machines.
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/phpunit.xml.dist export-ignore
/tests export-ignore
/.editorconfig export-ignore
/.php-cs-fixer.dist.php export-ignore
/phpstan.neon.dist export-ignore
/docs export-ignore
/deploy.sh export-ignore
/docker-compose.yml export-ignore
/scripts/test-all-architectures.sh export-ignore
/scripts/README.md export-ignore

# Maintainer-only tooling. These rewrite files under src/ and tests/, which do
# not meaningfully exist in a vendored install, and they were shipping while
# update-fingerprint-baseline.php alone was excluded — an inconsistent split
# that also left a composer script pointing at a file the dist did not contain.
/scripts/update-fingerprint-baseline.php export-ignore
/scripts/update-impersonate.php export-ignore
/scripts/update-browsers.php export-ignore
/scripts/update-binaries.php export-ignore
/scripts/lib/ConfigGenerator.php export-ignore
/scripts/lib/SourceEditor.php export-ignore
/scripts/lib/UpstreamPatch.php export-ignore
/scripts/record-upstream-checksums.php export-ignore
